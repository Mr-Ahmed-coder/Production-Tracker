PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Persistent local MongoDB (Windows MongoDB service). Atlas is not required.
MONGODB_URI=mongodb://127.0.0.1:27017/prodtrack
# Production requires HTTPS; NODE_ENV=production automatically enables Secure __Host- cookies.

# Optional email reminders. Disabled until you explicitly configure both API and worker.
# Never place these secrets in frontend variables or commit a populated .env file.
EMAIL_REMINDERS_ENABLED=false
RESEND_API_KEY=
# A mailbox on your own Resend-verified sender domain (SPF/DKIM configured).
EMAIL_FROM=
# Public FRONTEND origin, HTTPS in production, no path. Also include in CLIENT_ORIGIN.
EMAIL_APP_URL=http://127.0.0.1:5173
# Generate at least 32 random bytes; share the same stable secret with API and cron worker.
EMAIL_TOKEN_SECRET=
